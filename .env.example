# Solana RPC — mainnet
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# base58 secret or JSON byte array. Required for real transactions.
SOLANA_PRIVATE_KEY=

# Simulation by default. Set ONCHAIN=true only after funded-wallet and mint validation.
ONCHAIN=false
NETWORK=mainnet

# PYUSD on Solana mainnet (Token-2022, 6 decimals)
# Official mint: 2b1kV6DkPAnxd5ixfnxCpjxmKwqjjaYmCZfHsFu24GXo
USE_PYUSD=true
PYUSD_NETWORK=mainnet

# Fallback USDC mainnet mint (if not using PYUSD)
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Pyth Pro market data (server-side only)
# Never commit the real API key.
PYTH_API_KEY=
PYTH_PRO_URL=https://pyth-lazer.dourolabs.app
PYTH_PRO_CHANNEL=fixed_rate@200ms
PYTH_AAPL_FEED_ID=3191
PYTH_MSFT_FEED_ID=3196
PYTH_NVDA_FEED_ID=3188
PYTH_TSLA_FEED_ID=3185
PYTH_SPCX_FEED_ID=3316

# Tokenized-equity execution
# paper (default) | backpack | jupiter
EXECUTION_MODE=paper
STOCK_SYMBOLS=AAPL,TSLA,NVDA
DEMO_TRADE_USDC=1

# Backpack Securities / Exchange stock execution
# Keep live trading disabled until credentials, market and risk limits are verified.
BACKPACK_API_URL=https://api.backpack.exchange
BACKPACK_API_KEY=
BACKPACK_API_SECRET=
BACKPACK_LIVE_TRADING=false
BACKPACK_MAX_ORDER_USDC=5
# Only enable after verifying credentials and account balance.
BACKPACK_AUTO_ACCEPT_RFQ=false
BACKPACK_RFQ_WAIT_MS=10000

# Jupiter xStock path (EXECUTION_MODE=jupiter)
# Set mint addresses for tokenized equities you intend to swap.
JUPITER_API_URL=https://api.jup.ag/swap/v1
JUPITER_API_KEY=
JUPITER_SLIPPAGE_BPS=100
XSTOCK_AAPL_MINT=
XSTOCK_TSLA_MINT=
XSTOCK_NVDA_MINT=
XSTOCK_MSFT_MINT=

# PayPal (sandbox for dual-rail; switch to live only if you have production credentials)
# Get from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
# Keep live mode disabled until PayPal sandbox E2E validation is complete.
PAYPAL_ALLOW_LIVE=false
PAYPAL_AUTO_ORDER=false
APP_URL=http://localhost:3000

# Durable PayPal order ledger and API rate limits (required on Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional OpenAI-compatible AI Gateway rail advisor; secrets stay server-side.
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
