# Safe default: devnet + simulation. Mainnet preparation does not enable transactions.
NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Mainnet RPC (configure only after reviewing provider and rate limits):
# SOLANA_MAINNET_RPC_URL=

# base58 secret or JSON byte array. Required for real transactions.
SOLANA_PRIVATE_KEY=

# Real transactions disabled by default; mainnet needs a second opt-in
ONCHAIN=false
ALLOW_MAINNET_TRANSACTIONS=false
# Second independent operator gate. Keep false until explicit mainnet authorization.
MAINNET_TX_APPROVED=false

# Payment Channels production candidate: classic SPL USDC (6 decimals).
# Mainnet USDC mint: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Devnet USDC mint (default for NETWORK=devnet): 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Set USDC_MINT to the Mainnet mint only when NETWORK=mainnet-beta and the
# mainnet execution approval gates are deliberately enabled.
# PYUSD is Token-2022 and its active mint extensions are not all accepted by
# the deployed Payment Channels program; do not use PYUSD for channel escrow.
USE_PYUSD=false
PYUSD_NETWORK=devnet
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
PAYMENT_CHANNELS_TREASURY_OWNER=Cs2zdfUNonRdRGsiZUQQLdTxzxVvJZmgiX2mpLYKuEqP

# Pyth Pro market data (server-side only)
# Never commit the real API key.
PYTH_API_KEY=
PYTH_PRO_URL=https://pyth-lazer.dourolabs.app
PYTH_PRO_CHANNEL=fixed_rate@200ms
PYTH_AAPL_FEED_ID=3191
PYTH_MSFT_FEED_ID=3196
PYTH_NVDA_FEED_ID=3188
PYTH_TSLA_FEED_ID=3185
PYTH_SPCX_FEED_ID=3316

# Tokenized-equity execution
# paper (default) | backpack | jupiter
EXECUTION_MODE=paper
STOCK_SYMBOLS=AAPL,TSLA,NVDA
DEMO_TRADE_USDC=1

# Backpack Securities / Exchange stock execution
# Keep live trading disabled until credentials, market and risk limits are verified.
BACKPACK_API_URL=https://api.backpack.exchange
BACKPACK_API_KEY=
BACKPACK_API_SECRET=
BACKPACK_LIVE_TRADING=false
BACKPACK_MAX_ORDER_USDC=5
# Only enable after verifying credentials and account balance.
BACKPACK_AUTO_ACCEPT_RFQ=false
BACKPACK_RFQ_WAIT_MS=10000

# Jupiter xStock path (EXECUTION_MODE=jupiter)
# Set mint addresses for tokenized equities you intend to swap.
JUPITER_API_URL=https://api.jup.ag/swap/v1
JUPITER_API_KEY=
JUPITER_SLIPPAGE_BPS=100
XSTOCK_AAPL_MINT=
XSTOCK_TSLA_MINT=
XSTOCK_NVDA_MINT=
XSTOCK_MSFT_MINT=

# PayPal (sandbox for dual-rail; switch to live only if you have production credentials)
# Get from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_LIVE_ENABLED=false
# Additional gate: real PayPal capture remains disabled until explicit approval.
PAYPAL_LIVE_CAPTURE_ENABLED=false
PAYPAL_WEBHOOK_ID=
PAYPAL_RETURN_URL=http://localhost:3000/paypal/return
PAYPAL_CANCEL_URL=http://localhost:3000/paypal/cancel

# API access token for protected ChannelSwarm endpoints. Generate a long random value.
# Never commit the real token.
CHANNELSWARM_API_TOKEN=

# Optional local persistence settings. Vercel serverless filesystem is ephemeral.
DATA_DIR=./data
PERSISTENCE=true

# Persistent payment ledger + x402 replay watermark (Vercel KV / Upstash REST).
# Required for production payment/replay flows; PayPal Live additionally requires explicit gates.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel AI Gateway payment-rail advisor. Suggestions never execute payments.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=nvidia/nemotron-3-nano-30b-a3b
