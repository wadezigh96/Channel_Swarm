# Devnet USDC. Change if you use another mint.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Pyth Hermes market data (server-side only)
PYTH_API_KEY=
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_AAPL_FEED_ID=
PYTH_MSFT_FEED_ID=
