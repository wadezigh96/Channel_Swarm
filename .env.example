# Solana RPC
SOLANA_RPC_URL=https://api.devnet.solana.com

# base58 secret or JSON byte array. Required for ONCHAIN=true.
SOLANA_PRIVATE_KEY=

# sim (default) | onchain
ONCHAIN=false
NETWORK=devnet

# Devnet USDC. Change if you use another mint.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Pyth Hermes market data (server-side only)
PYTH_API_KEY=
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_AAPL_FEED_ID=
PYTH_MSFT_FEED_ID=
PYTH_NVDA_FEED_ID=
PYTH_TSLA_FEED_ID=

# Backpack Securities / Exchange stock execution
# Keep live trading disabled until credentials, market and risk limits are verified.
BACKPACK_API_URL=https://api.backpack.exchange
BACKPACK_API_KEY=
BACKPACK_API_SECRET=
BACKPACK_LIVE_TRADING=false
BACKPACK_MAX_ORDER_USDC=5
# Only enable after verifying credentials and account balance.
BACKPACK_AUTO_ACCEPT_RFQ=false
BACKPACK_RFQ_WAIT_MS=10000
