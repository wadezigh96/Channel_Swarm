{
  "name": "channel-swarm-agent",
  "version": "0.4.1",
  "description": "ChannelSwarm — official Solana Payment Channels client + A2A swarm + Stocknized Agent + PayPal dual-rail",
  "type": "module",
  "scripts": {
    "cli": "tsx cli/channelswarm.ts",
    "mcp": "tsx src/mcp/server.ts",
    "demo": "tsx examples/demo-swarm.ts",
    "demo:onchain": "ONCHAIN=true tsx examples/demo-swarm.ts",
    "demo:equity": "tsx examples/equity-execution-demo.ts",
    "demo:paypal": "tsx examples/paypal-swarm-demo.ts",
    "dashboard": "npx serve docs -p 3000",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test src/payments/voucher.test.ts src/payments/x402.test.ts src/payments/token-compatibility.test.ts src/payments/channel-manager.test.ts src/payments/rail-advisor.test.ts src/wallet.test.ts api/paypal-order.test.ts api/paypal-webhook.test.ts",
    "x402:demo": "tsx examples/x402-demo.ts"
  },
  "keywords": [
    "solana",
    "agentic-payments",
    "x402",
    "payment-channels",
    "ai-agent",
    "stocknized",
    "a2a",
    "paypal",
    "pyusd"
  ],
  "author": "wadezigh96",
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "@solana/spl-token": "^0.4.9",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "tweetnacl": "^1.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vercel/node": "^5.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
